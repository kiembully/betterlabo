{
  "name": "@betterlabo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BetterLabo intake API — Express 5 + Mongoose 9. Citizen report persistence, console CRUD and public stats.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:memory": "tsx src/dev-memory.ts server",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "seed": "tsx src/dev-memory.ts seed",
    "smoke": "tsx src/dev-memory.ts smoke"
  },
  "dependencies": {
    "@betterlabo/shared": "*",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
