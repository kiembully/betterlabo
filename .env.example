# ─────────────────────────────────────────────────────────────────────────────
# BetterLabo — environment template
# Copy to `.env.local` at the repo ROOT (`cp .env.example .env.local`).
# Both apps read this one file: Next reads apps/web/.env.local directly, and the
# Express API walks up to the repo root and loads .env.local itself (see
# apps/api/src/env.ts). Nothing here is required to run the portal read-only —
# every value below has a working default or degrades gracefully.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public site identity ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── API ──────────────────────────────────────────────────────────────────────
# Browser-side URL used by the citizen reporting form.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-to-server URL. In the single-project Vercel arrangement the Next server
# mounts the Express app in-process on a loopback port and this can stay unset.
API_INTERNAL_URL=
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins for the reporting API.
CORS_ORIGINS=http://localhost:3000

# ── Database (citizen reports only — the portal reads cached static JSON) ─────
# Without this the API boots in "no-database" mode: reporting returns 503
# db_unavailable and every public page still renders from static JSON.
# Reviewers: `npm run dev:memory` boots a real in-memory mongod instead.
MONGODB_URI=
MONGODB_DB=betterlabo
# Convenience only — the API reads MONGODB_URI and ignores these. They are here so
# the credentials live in one place if you build the URI with a script, and so the
# template documents every value a working .env.local carries. NEVER commit them.
MONGODB_USERNAME=
MONGODB_PASSWORD=

# ── Admin console ────────────────────────────────────────────────────────────
# Long random string: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
ADMIN_TOKEN=
ADMIN_SESSION_SECRET=

# ── Abuse protection for the public reporting form ───────────────────────────
# Cloudflare Turnstile. With no secret configured the API runs in `off` mode and
# logs a warning; set TURNSTILE_MODE=enforce in production.
TURNSTILE_MODE=off
# 1x0000000000000000000000000000000AA is Cloudflare's official "always passes"
# test secret; swap for your production secret.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Rate limit for POST /api/reports, per IP, per window.
REPORT_RATE_LIMIT_MAX=5
REPORT_RATE_LIMIT_WINDOW_MS=600000

# ── Optional outbound forwarding of new reports ──────────────────────────────
# Serverless route from the spec: post each new report to a Discord/Slack webhook
# (or any endpoint). Leave blank to disable.
REPORT_WEBHOOK_URL=

# ── Optional: NOAH flood/landslide overlay ───────────────────────────────────
# The NOAH hazard tiles are 5.5 GB of PMTiles hosted on HuggingFace, so the map
# streams them by HTTP range request instead of shipping a copy. Leave blank and
# the hazard toggle is hidden with an explicit "not configured" notice. Set it to
# the URL in docs/data-sources.md to enable the overlay. Prefer the clipped
# static file produced by `npm run etl hazards` when you have it.
NEXT_PUBLIC_NOAH_PMTILES_URL=
NEXT_PUBLIC_NOAH_PMTILES_ATTRIBUTION=Project NOAH (DOST) — hazard layers, ODbL

# ── ETL ──────────────────────────────────────────────────────────────────────
# Where the ETL keeps large raw downloads (git-ignored).
ETL_CACHE_DIR=data/sources
# HuggingFace egress is throttled on some networks; the ETL retries and resumes.
ETL_HTTP_TIMEOUT_MS=600000
